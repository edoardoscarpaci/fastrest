# Shared environment defaults for varco examples.
# Copy to .env and fill in values as needed.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=varco_example
POSTGRES_USER=varco
POSTGRES_PASSWORD=varco

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=varco_example

# --- Memcached ---
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# --- Profiling ---
VARCO_PROFILING_ENABLED=false

# --- Auth ---
# SECRET_KEY=changeme
